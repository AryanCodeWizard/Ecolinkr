NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
REFRESH_TOKEN_TTL_DAYS=30
REDIS_URL=redis://127.0.0.1:6379
# User service (receives new users) and the shared secret both services use for internal calls
USER_SERVICE_URL=http://127.0.0.1:3001
INTERNAL_API_KEY=change-me-to-a-long-random-string
# Number of reverse proxies (e.g. the gateway) in front of this service; needed for the real client IP
TRUST_PROXY=0
OTP_SECRET=change-me-to-another-long-random-string
OTP_TTL_MINUTES=10
# SMTP: if SMTP_HOST is unset (non-production only) emails are printed to the console instead of sent
#SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EcoLinkr <no-reply@ecolinkr.example>"
# Frontend page that receives ?token=... from the password-reset email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=30
