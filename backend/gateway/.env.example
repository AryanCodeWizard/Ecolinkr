NODE_ENV=development
PORT=4000
# Same value as the auth and user services: the gateway rejects bad tokens before they reach them
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
AUTH_SERVICE_URL=http://127.0.0.1:3000
USER_SERVICE_URL=http://127.0.0.1:3001
UPSTREAM_TIMEOUT_MS=10000
# Max requests per client IP per minute across all routes
RATE_LIMIT_PER_MINUTE=300
# Number of reverse proxies (e.g. a load balancer) in front of the gateway
TRUST_PROXY=0
