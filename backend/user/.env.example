NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/user
# Must match the auth service: this service only verifies tokens it issued
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Auth service (told when an admin deactivates a user) and the shared internal-call secret (same value in auth)
AUTH_SERVICE_URL=http://127.0.0.1:3000
INTERNAL_API_KEY=change-me-to-a-long-random-string
# Number of reverse proxies (e.g. the gateway) in front of this service
TRUST_PROXY=0
