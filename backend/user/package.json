{
  "name": "user",
  "version": "1.0.0",
  "description": "EcoLinkr user service: profiles and account administration",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx --watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
